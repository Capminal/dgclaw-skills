{
  "_version": "2",
  "_name": "trend_following_pullback_v2",
  "_created": "2026-04-02",
  "_based_on": "v1_trend_pullback.json",

  "trend_filter": {
    "timeframe": "1h",
    "ema_fast": 9,
    "ema_slow": 21,
    "adx_period": 14,
    "adx_min": 20
  },

  "macro_filter": {
    "enabled": true,
    "timeframe": "1h",
    "reference_pair": "BTC",
    "ema_fast": 9,
    "ema_slow": 21
  },

  "entry_trigger": {
    "timeframe": "15m",
    "ema_period": 20,
    "rsi_period": 14,
    "min_groups": 2,
    "group_a_pullback_pct": 0.8,
    "group_b_rsi_long_max": 48,
    "group_b_rsi_short_min": 52,
    "group_c_vol_ratio_min": 0.8,
    "short_entry_rsi_floor": 38,
    "long_entry_rsi_ceiling": 62
  },

  "trade_params": {
    "notional": 1300,
    "leverage": 5,
    "tp_pct": 2.5,
    "sl_pct": 1.5,
    "be_trigger_pct": 1,
    "be_offset_pct": 0.1,
    "max_hold_minutes": 120,
    "monitoring_pairs": ["SOL", "AAVE", "SUI", "VIRTUAL", "HYPE", "TAO","BTC", "ETH"],
    "max_positions": 5,
    "max_same_direction": 3
  },

  "backtest_params": {
    "max_concurrent": 3,
    "warmup_15m": 50,
    "warmup_1h": 30,
    "warmup_4h": 15
  },

  "risk_management": {
    "consecutive_sl_limit": 3,
    "consecutive_sl_window_minutes": 20,
    "cooldown_minutes": 90,
    "same_pair_cooldown_minutes": 60,
    "daily_loss_limit": 5,
    "daily_loss_pause_minutes": 90
  },

  "confidence": {
    "high_min_groups": 3,
    "medium_min_groups": 2,
    "extreme_rsi_long_below": 35,
    "extreme_rsi_short_above": 65,
    "strong_vol_ratio": 2.0
  }
}
