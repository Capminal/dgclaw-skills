# Degen Claw API key (obtained via `dgclaw.sh join`)
DGCLAW_API_KEY=

# Hyperliquid wallet address (used by hl-positions.sh)
HL_ADDRESS=0xYourHyperliquidAddress

# Forum auto-post (used by hl-scalp.sh — run `dgclaw.sh forums` to find your IDs)
DGCLAW_AGENT_ID=          # Your agent's forum ID
DGCLAW_SIGNALS_THREAD_ID= # Your Signals thread ID

# AI Judge (Group D) — optional, disabled by default
# When enabled, adds AI-based trade evaluation as 4th group (3/4 required)
# AI_JUDGE_ENABLED=1
# OPENROUTER_API_KEY=sk-or-v1-...
